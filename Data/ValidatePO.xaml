          <Throw DisplayName="Throw BE - Invalid Purchase Order" Exception="[new BusinessRuleException(&quot;The PO has no valid rows&quot;)]" sap:VirtualizedContainerService.HintSize="382,114" sap2010:WorkflowViewState.IdRef="Throw_2" />
        </Sequence>
      </If.Then>
