  <Sequence DisplayName="ValidatePO" sap:VirtualizedContainerService.HintSize="808,1501" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="scg:List(x:String)" Name="missinCollums" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <Assign DisplayName="Assign - Missing Columns" sap:VirtualizedContainerService.HintSize="450,115" sap2010:WorkflowViewState.IdRef="Assign_2">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:List(x:String)">[missinCollums]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:List(x:String)">[{"Category","Brand","Qty","Min price per unit","Max price per unit"}.Where(Function(c) Not in_dt_purchaseOrder.Columns.Contains(c)).ToList]</InArgument>
      </Assign.Value>
    </Assign>
    <If Condition="[missinCollums.Any]" DisplayName="If - Incomplete purchase Order" sap:VirtualizedContainerService.HintSize="450,571" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Sequence DisplayName="Then" sap:VirtualizedContainerService.HintSize="416,174" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <Throw DisplayName="Throw BE - Missing colums" Exception="[new BusinessRuleException(&quot;PO file is missing&quot;)]" sap:VirtualizedContainerService.HintSize="382,114" sap2010:WorkflowViewState.IdRef="Throw_1" />
        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Else" sap:VirtualizedContainerService.HintSize="416,226" sap2010:WorkflowViewState.IdRef="Sequence_6">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <ui:LogMessage DisplayName="Log Message - All colums exists" sap:VirtualizedContainerService.HintSize="382,166" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Info" Message="[&quot;There is NO missing colums in the input data&quot;]" />
        </Sequence>
      </If.Else>
    </If>
    <Assign DisplayName="Assign - Valid Purchase Order" sap:VirtualizedContainerService.HintSize="450,115" sap2010:WorkflowViewState.IdRef="Assign_5">
      <Assign.To>
        <OutArgument x:TypeArguments="sd:DataTable">[out_dt_validPO]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="sd:DataTable">[in_dt_purchaseOrder.AsEnumerable().Where(Function(row) Not String.IsNullOrWhiteSpace(row("Category").ToString.Trim) AndAlso {"phones", "laptops", "monitors"}.Contains(row("Category").ToString.Trim.ToLower) AndAlso Not String.IsNullOrWhiteSpace(row("Brand").ToString.Trim) AndAlso IsNumeric(row("Qty").ToString.Trim) AndAlso CInt(row("Qty").ToString.Trim) &gt; 0 AndAlso IsNumeric(row("Min price per unit").ToString.Trim) AndAlso IsNumeric(row("Max price per unit").ToString.Trim)).CopyToDataTable()]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Assign - invalidRows(skippedRows)" sap:VirtualizedContainerService.HintSize="450,115" sap2010:WorkflowViewState.IdRef="Assign_6">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_skippedRows]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[String.Join(Environment.NewLine, in_dt_purchaseOrder.AsEnumerable().Where(Function(r) String.IsNullOrWhiteSpace(r("Category").ToString.Trim) OrElse Not {"phones", "laptops", "monitors"}.Contains(r("Category").ToString.Trim.ToLower) OrElse String.IsNullOrWhiteSpace(r("Brand").ToString.Trim) OrElse Not IsNumeric(r("Qty").ToString.Trim) OrElse CInt(r("Qty").ToString.Trim) &lt;= 0 OrElse Not IsNumeric(r("Min price per unit").ToString.Trim) OrElse Not IsNumeric(r("Max price per unit").ToString.Trim)).Select(Function(r) "- Categorie: " &amp; r("Category").ToString &amp; " | Brand: " &amp; r("Brand").ToString &amp; " | Qty: " &amp; r("Qty").ToString &amp; " ---&gt; MOTIV: " &amp; If(String.IsNullOrWhiteSpace(r("Category").ToString.Trim) OrElse Not {"phones", "laptops", "monitors"}.Contains(r("Category").ToString.Trim.ToLower), "[Categorie necunoscută/lipsă] ", "") &amp; If(String.IsNullOrWhiteSpace(r("Brand").ToString.Trim), "[Brand lipsă] ", "") &amp; If(Not IsNumeric(r("Qty").ToString.Trim) OrElse CInt(r("Qty").ToString.Trim) &lt;= 0, "[Cantitate invalidă/zero] ", "") &amp; If(Not IsNumeric(r("Min price per unit").ToString.Trim) OrElse Not IsNumeric(r("Max price per unit").ToString.Trim), "[Preț invalid/text]", "")))]</InArgument>
      </Assign.Value>
    </Assign>
    <If Condition="[out_dt_validPO.Rows.Count  = 0]" DisplayName="If - No Valid Rows" sap:VirtualizedContainerService.HintSize="450,562" sap2010:WorkflowViewState.IdRef="If_3">
      <If.Then>
        <Sequence DisplayName="Then" sap:VirtualizedContainerService.HintSize="416,174" sap2010:WorkflowViewState.IdRef="Sequence_7">
