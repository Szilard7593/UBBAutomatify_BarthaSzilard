    <ui:InvokeCode ContinueOnError="{x:Null}" Code="Dim dt As New System.Data.DataTable()&#xD;&#xA;dt.Columns.Add(&quot;PoFilePath&quot;, GetType(String))&#xD;&#xA;dt.Columns.Add(&quot;EmailBodyText&quot;, GetType(String))&#xD;&#xA;dt.Columns.Add(&quot;SenderEmail&quot;, GetType(String))&#xD;&#xA;&#xD;&#xA;Dim baseFolder As String = If(String.IsNullOrWhiteSpace(in_baseFolder), &quot;Data\InputEmail&quot;, in_baseFolder)&#xD;&#xA;&#xD;&#xA;For i As Integer = 0 To in_matchingMails.Count - 1&#xD;&#xA;    Dim mail = in_matchingMails(i)&#xD;&#xA;&#xD;&#xA;    ' 1. Creeaza un folder separat per email ca sa nu se suprascrie fisiere cu acelasi nume&#xD;&#xA;    Dim emailFolder As String = System.IO.Path.Combine(baseFolder, $&quot;Email_{i + 1}&quot;)&#xD;&#xA;    System.IO.Directory.CreateDirectory(emailFolder)&#xD;&#xA;&#xD;&#xA;    ' 2. Gaseste si salveaza atasamentul PO (.xlsx)&#xD;&#xA;    Dim poAttachment = mail.Attachments.First(Function(a) _&#xD;&#xA;        a.Name.ToLower().EndsWith(&quot;.xlsx&quot;) AndAlso _&#xD;&#xA;        (a.Name.ToLower().Contains(&quot;po&quot;) OrElse a.Name.ToLower().Contains(&quot;purchase&quot;)) AndAlso _&#xD;&#xA;        Not a.Name.ToLower().Contains(&quot;statusreport&quot;))&#xD;&#xA;&#xD;&#xA;    Dim safeFileName As String = System.IO.Path.GetFileName(poAttachment.Name)&#xD;&#xA;    Dim fullFilePath As String = System.IO.Path.Combine(emailFolder, safeFileName)&#xD;&#xA;&#xD;&#xA;    If poAttachment.ContentStream.CanSeek Then poAttachment.ContentStream.Position = 0&#xD;&#xA;    Using fs As New System.IO.FileStream(fullFilePath, System.IO.FileMode.Create, System.IO.FileAccess.Write)&#xD;&#xA;        poAttachment.ContentStream.CopyTo(fs)&#xD;&#xA;    End Using&#xD;&#xA;&#xD;&#xA;    ' 3. Extrage textul din Body (inclusiv pentru emailuri HTML / Outlook)&#xD;&#xA;    Dim rawBody As String = mail.Body&#xD;&#xA;&#xD;&#xA;    If String.IsNullOrWhiteSpace(rawBody) AndAlso mail.Headers IsNot Nothing Then&#xD;&#xA;        rawBody = If(Not String.IsNullOrWhiteSpace(mail.Headers(&quot;PlainText&quot;)),&#xD;&#xA;                     mail.Headers(&quot;PlainText&quot;),&#xD;&#xA;                     mail.Headers(&quot;HTMLBody&quot;))&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    If String.IsNullOrWhiteSpace(rawBody) AndAlso mail.AlternateViews IsNot Nothing AndAlso mail.AlternateViews.Count &gt; 0 Then&#xD;&#xA;        Dim view = mail.AlternateViews(0)&#xD;&#xA;        If view.ContentStream.CanSeek Then view.ContentStream.Position = 0&#xD;&#xA;        Using sr As New System.IO.StreamReader(view.ContentStream, System.Text.Encoding.UTF8, True, 1024, True)&#xD;&#xA;            rawBody = sr.ReadToEnd()&#xD;&#xA;        End Using&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    Dim decodedBody As String = System.Net.WebUtility.HtmlDecode(If(rawBody, String.Empty))&#xD;&#xA;    Dim noHtmlBody As String = System.Text.RegularExpressions.Regex.Replace(decodedBody, &quot;&lt;.*?&gt;&quot;, &quot; &quot;)&#xD;&#xA;    Dim cleanBody As String = System.Text.RegularExpressions.Regex.Replace(noHtmlBody, &quot;\s+&quot;, &quot; &quot;).Trim()&#xD;&#xA;    Dim senderEmail As String = mail.From.Address.Trim()&#xD;&#xA;&#xD;&#xA;    dt.Rows.Add(fullFilePath, cleanBody, senderEmail)&#xD;&#xA;Next&#xD;&#xA;&#xD;&#xA;out_dt_emailInputs = dt" DisplayName="Invoke Code - Save Attachments and Build Email Inputs" sap:VirtualizedContainerService.HintSize="450,197" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
